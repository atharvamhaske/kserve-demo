local_resource(
  'control-plane-health',
  serve_cmd='./scripts/72-watch-status.sh',
  readiness_probe=probe(
    timeout_secs=15,
    period_secs=30,
    success_threshold=1,
    failure_threshold=1,
    exec=exec_action(command=['./scripts/70-status.sh']),
  ),
  deps=['scripts/70-status.sh', 'scripts/72-watch-status.sh', 'scripts/lib.sh', 'config/workshop.env'],
  labels=['workshop'],
)

