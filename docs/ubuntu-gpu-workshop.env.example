# Copy this file to $HOME/ubuntu-gpu-workshop.env.
# Edit the copy before you start the workshop.

# Kubernetes resource names
PROFILE=everest-gpu
INSTANCE=qwen-demo
INSTANCE_NS=default
PROVIDER_NS=provider-kserve
EVEREST_NS=everest-system
JOB_NS=kserve-localmodel-jobs
NODE_GROUP=model-workers
STORAGE_CLASS=local-model

# Model and runtime
MODEL_URI=hf://Qwen/Qwen3-0.6B
MODEL_NAME=qwen3-0.6b
RUNTIME_IMAGE=ghcr.io/llm-d/llm-d-cuda:v0.9.0

# Provider source
PROVIDER_REPO=https://github.com/atharvamhaske/provider-kserve.git
PROVIDER_REF=9185bfd35626cef5753586a1499c0b4e0f9adbf5
REPO_DIR=$HOME/src/provider-kserve-localmodel
IMAGE_REPO=provider-kserve-pr117

# Pinned platform versions
KUBERNETES_VERSION=v1.35.0
CERT_MANAGER_VERSION=v1.21.2
EVEREST_VERSION=2.0.0-dev.4

# Minikube resources
MINIKUBE_CPUS=4
MINIKUBE_MEMORY_MIB=12288

# LocalModel file identity
LOCAL_MODEL_UID=1000
LOCAL_MODEL_GID=1000

# Model limits for this demonstration
MODEL_SIZE=3Gi
CACHE_STORAGE_SIZE=20Gi
MODEL_CPU_LIMIT=2
MODEL_MEMORY_LIMIT=6Gi
MODEL_MAX_LENGTH=2048
MODEL_MAX_SEQUENCES=1
GPU_MEMORY_UTILIZATION=0.2
